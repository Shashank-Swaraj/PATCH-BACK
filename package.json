{
  "name": "patchback-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "PATCHBACK: Security Regression Intelligence for Open-Source Packages",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "benchmark": "npm run benchmark -w @patchback/core",
    "web": "npm run dev -w @patchback/web",
    "cli": "node packages/cli/dist/index.js"
  },
  "keywords": [
    "security",
    "regression",
    "ast",
    "invariants",
    "cve",
    "static-analysis"
  ],
  "author": "PATCHBACK Team",
  "license": "Apache-2.0"
}
